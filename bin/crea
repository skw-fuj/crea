#!/usr/bin/env python3
"""CREA command line."""
from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT))

# The audio stack (sounddevice) lives in CREA's venv, not in system python.
# Re-exec into it once, so every command works no matter how it was invoked.
_VENV = ROOT / ".venv/bin/python3"
if _VENV.exists() and not sys.executable.startswith(str(ROOT / ".venv")):
    import os
    os.execv(str(_VENV), [str(_VENV), __file__, *sys.argv[1:]])

from core.config import load
from core.vault import Vault

USAGE = """crea <command>

  Talking to it
    ask "<question>"      one question, answered out loud
    listen                the always-on "Hey CREA" loop
    say "<text>"          speak a line
    enrol                 teach CREA your voice
    voice-check on|off    only answer you, or answer anyone
    brief                 today's briefing, spoken

  Doing things
    skills                every skill, and what it needs
    run <skill> [args]    run one skill now
    jobs [status]         the pipeline
    card                  import a plugged-in SD card
    board                 what deserves attention today

  Setting up
    status                honest health of every part
    connect [service]     link Acuity, Google, WhatsApp, Higgsfield, Apify
    schedule              install the background jobs
    init                  create the vault
    fixtures              load demo data
    voice start|stop      the local speech service
"""


def _skills(cfg, vault):
    from core.connectors import load_all
    from core.skills import build
    return build(cfg, vault, load_all(cfg))


def _print_result(r) -> int:
    print(r["summary"])
    if not r.get("ok"):
        return 1
    return 0


def main(argv: list[str]) -> int:
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(USAGE)
        return 0

    cfg = load()
    # secrets live outside the config file; pull them into the environment first
    from core.connect import load_env
    load_env(cfg)
    vault = Vault(cfg.path("paths.vault"))
    cmd = argv[1]
    rest = argv[2:]

    # ---------------------------------------------------------------- status

    if cmd == "status":
        from core.brain import make_brain
        from core.connectors import status_all
        from core.voice.providers import make_stt, make_tts
        from core.voice.wake import make_wake
        out = {"agent": cfg.get("identity.agent_name"),
               "vault": str(vault.root),
               "jobs_in_vault": len(vault.jobs()) if vault.root.exists() else 0}
        for name, fn in (("tts", lambda: make_tts(cfg).health()),
                         ("stt", lambda: make_stt(cfg).health()),
                         ("wake", lambda: make_wake(cfg, make_stt(cfg)).health()),
                         ("brain", lambda: make_brain(cfg).health())):
            try:
                out[name] = fn()
            except Exception as e:
                out[name] = {"reachable": False, "error": str(e)}
        from core import clock
        out["clock"] = {"now": clock.now(cfg).strftime("%Y-%m-%d %H:%M:%S"),
                        "zone": cfg.get("identity.timezone"),
                        "abbrev": clock.label(cfg)}
        drift = clock.drift_warning(cfg)
        if drift:
            out["clock"]["warning"] = drift
        out["connectors"] = status_all(cfg)
        skills = _skills(cfg, vault)
        out["skills"] = {"total": len(skills),
                         "ready": sum(1 for s in skills.values() if s.available()),
                         "blocked": {n: s.blocked_by()
                                     for n, s in skills.items() if not s.available()}}
        print(json.dumps(out, indent=2))
        return 0

    # ---------------------------------------------------------------- skills

    if cmd == "skills":
        skills = _skills(cfg, vault)
        width = max(len(n) for n in skills)
        for name, s in skills.items():
            mark = "ok " if s.available() else "needs"
            need = "" if s.available() else " " + ", ".join(s.blocked_by())
            sched = f"  [{s.schedule}]" if s.schedule else ""
            print(f"  {mark:<5} {name:<{width}}  {s.title}{need}{sched}")
        ready = sum(1 for s in skills.values() if s.available())
        print(f"\n{ready}/{len(skills)} ready. The rest need an account connecting "
              f"— run: crea connect")
        return 0

    if cmd == "run":
        if not rest:
            print("which skill? run: crea skills")
            return 1
        skills = _skills(cfg, vault)
        name = rest[0]
        if name not in skills:
            print(f"no skill called '{name}'. run: crea skills")
            return 1
        def coerce(v: str):
            """Command-line arguments are strings; skills expect real types."""
            if v == "":
                return True
            low = v.lower()
            if low in ("true", "yes", "on"):
                return True
            if low in ("false", "no", "off"):
                return False
            try:
                return int(v)
            except ValueError:
                pass
            try:
                return float(v.lstrip("$").replace(",", ""))
            except ValueError:
                return v

        kwargs = {}
        for arg in rest[1:]:
            if arg.startswith("--"):
                k, _, v = arg[2:].partition("=")
                kwargs[k.replace("-", "_")] = coerce(v)
            else:
                kwargs.setdefault("text", arg)
        return _print_result(skills[name].run(**kwargs))

    # shorthands for the ones used daily
    if cmd in ("card", "board", "brief", "leads", "checkins", "invoice"):
        skills = _skills(cfg, vault)
        key = {"card": "card", "board": "board", "brief": "brief",
               "leads": "leads", "checkins": "checkins", "invoice": "invoice"}[cmd]
        return _print_result(skills[key].run(**({"speak": True} if cmd in ("brief",) else {})))

    if cmd == "jobs":
        skills = _skills(cfg, vault)
        return _print_result(skills["jobs"].run(status=rest[0] if rest else None))

    # --------------------------------------------------------------- connect

    if cmd == "connect":
        from core import connect as connect_mod
        return connect_mod.run(cfg, rest[0] if rest else None)

    if cmd == "schedule":
        from core import scheduler
        skills = _skills(cfg, vault)
        if rest[:1] == ["off"]:
            print(f"removed {scheduler.uninstall()} scheduled job(s)")
            return 0
        if rest[:1] == ["status"]:
            rows = scheduler.status()
            if not rows:
                print("no scheduled jobs installed. run: crea schedule")
                return 0
            for r in rows:
                print(f"  {r['skill']:<16} last exit {r['last_exit']}"
                      f"{'  (running)' if r['running'] else ''}")
            return 0
        done = scheduler.install(cfg, skills)
        for d in done:
            mark = "ok  " if d["ok"] else "FAIL"
            print(f"  {mark} {d['skill']:<16} {d.get('schedule','')}")
        print(f"\n{sum(1 for d in done if d['ok'])} background job(s) installed.")
        return 0

    # ----------------------------------------------------------------- vault

    if cmd == "init":
        vault.init()
        vault.render_dashboard()
        print(f"vault ready at {vault.root}")
        return 0

    if cmd == "fixtures":
        from core.fixtures import build as seed
        print(json.dumps(seed(vault), indent=2))
        return 0

    if cmd == "dashboard":
        print(vault.render_dashboard())
        return 0

    # ----------------------------------------------------------------- voice

    if cmd == "say":
        from core.voice.loop import play
        from core.voice.providers import make_tts
        play(make_tts(cfg).speak(" ".join(rest) or "CREA online."))
        return 0

    if cmd == "ask":
        from core.voice.loop import answer
        print(answer(cfg, vault, " ".join(rest)))
        return 0

    if cmd == "enrol" or cmd == "enroll":
        from core.voice.speaker import Speaker
        from core.voice.wake import record_command, write_wav, rms
        import numpy as np
        import sounddevice as sd
        sp = Speaker(cfg)
        if not sp.available():
            print("The voice service isn't running, or speaker recognition isn't installed.")
            print("Try:  crea voice start")
            return 1

        n = sp.min_samples
        phrase = cfg.get("identity.wake_phrase")
        spoken = bool(kwargs_spoken) if (kwargs_spoken := ("--spoken" in rest)) else False

        if spoken:
            # Enrolment you can do without looking at a screen: CREA says what
            # it wants, a tone marks each recording.
            #
            # ONE persistent input stream for the whole run. Opening and closing
            # a stream per sample deadlocks CoreAudio on macOS — the IO thread
            # blocks in AudioUnitGetProperty while the main thread waits on a
            # semaphore, and nothing ever returns. Same rolling-buffer pattern
            # the wake loop uses, which is proven on this machine.
            import threading as _th
            import time as _t
            import wave as _w, io as _io
            from collections import deque
            import numpy as np
            import sounddevice as sd
            from core.voice.loop import play
            from core.voice.providers import make_tts
            from core.voice.wake import write_wav, rms, SAMPLE_RATE

            tts = make_tts(cfg)
            TAKE = 4.5                       # seconds captured per sample
            buf = deque(maxlen=int(TAKE * SAMPLE_RATE))
            lock = _th.Lock()

            def _cb(indata, frames, t, status):
                with lock:
                    buf.extend(indata[:, 0])

            def beep(freq=880, ms=170):
                t = np.linspace(0, ms / 1000, int(SAMPLE_RATE * ms / 1000), False)
                tone = (np.sin(freq * 2 * np.pi * t) * 0.3 * 32767).astype("int16")
                f = int(SAMPLE_RATE * 0.02)
                tone[:f] = (tone[:f] * np.linspace(0, 1, f)).astype("int16")
                tone[-f:] = (tone[-f:] * np.linspace(1, 0, f)).astype("int16")
                wp = write_wav(tone)
                subprocess.run(["afplay", str(wp)], check=False)
                wp.unlink(missing_ok=True)

            def grab() -> bytes | None:
                with lock:
                    a = np.array(buf, dtype="int16")
                if a.size < int(1.0 * SAMPLE_RATE) or rms(a) < 0.004:
                    return None
                wp = write_wav(a)
                data = wp.read_bytes()
                wp.unlink(missing_ok=True)
                return data

            samples = []
            with sd.InputStream(samplerate=SAMPLE_RATE, channels=1, dtype="int16",
                                blocksize=int(0.1 * SAMPLE_RATE), callback=_cb):
                play(tts.speak(
                    "I am going to learn your voice. When you hear the tone, say a "
                    "full sentence, normally — anything at all, just keep talking "
                    f"until I stop you. I will ask {n} times."))
                for i in range(1, n + 1):
                    # Full sentences, not the bare wake phrase: identity is checked
                    # on the command the speaker gives, which is several seconds of
                    # speech. Two seconds of "Hey CREA" is measurably too little.
                    hint = {1: "Tell me what you did yesterday.",
                            2: "Again, a little further from the microphone.",
                            3: "Again, closer this time.",
                            4: "Again — tell me about a shoot you have coming up.",
                            5: "Last one. Anything at all, normally."}.get(i)
                    play(tts.speak(hint or "Once more."))
                    _t.sleep(0.25)
                    with lock:
                        buf.clear()          # never re-use the previous take
                    beep()
                    _t.sleep(TAKE)
                    data = grab()
                    if data is None:
                        print(f"  sample {i}: nothing heard", flush=True)
                        play(tts.speak("I did not catch that."))
                        continue
                    with _w.open(_io.BytesIO(data)) as w:
                        secs = w.getnframes() / w.getframerate()
                    samples.append(data)
                    print(f"  sample {i}: {secs:.1f}s captured", flush=True)

            if len(samples) < 2:
                play(tts.speak("I did not get enough of that. We can try again later."))
                print("not enough usable samples")
                return 1
            try:
                out = sp.enrol(samples)
            except Exception as e:
                play(tts.speak("Something went wrong saving your voice."))
                print(f"enrol failed: {e}")
                return 1
            good = out["weakest"] >= 0.75
            play(tts.speak(
                f"Got it. I have your voice from {out['samples']} recordings."
                + ("" if good else " One of those sounded different from the rest. "
                                   "If I start missing you, do this again somewhere quieter.")))
            print(json.dumps(out, indent=2))
            return 0

        print(f"\nTeaching CREA your voice.\n")
        print(f"It'll ask you to say \"{phrase}\" {n} times.")
        print("Say it normally, the way you actually would. Vary it a bit —")
        print("closer, further, mid-sentence. That makes it more reliable.\n")

        samples = []
        for i in range(1, n + 1):
            input(f"  {i} of {n} — press Enter, then say it: ")
            audio = record_command(max_seconds=4.0, silence_run=0.8)
            data = audio.read_bytes()
            audio.unlink(missing_ok=True)
            import wave as _w, io as _io
            with _w.open(_io.BytesIO(data)) as w:
                secs = w.getnframes() / w.getframerate()
            if secs < 0.6:
                print("     too short, let's try that one again")
                continue
            samples.append(data)
            print(f"     got it ({secs:.1f}s)")

        if len(samples) < 2:
            print("\nNot enough usable recordings. Run it again.")
            return 1
        try:
            out = sp.enrol(samples)
        except Exception as e:
            print(f"\nCouldn't save your voice: {e}")
            return 1

        print(f"\nSaved. {out['samples']} recordings, consistency {out['self_similarity']:.2f}.")
        if out["weakest"] < 0.75:
            print("One of those was noticeably different from the others — if CREA")
            print("misses you later, run this again somewhere quieter.")
        if not sp.enabled:
            print("\nVoice check is currently OFF, so CREA still answers anyone.")
            print("Turn it on with:  crea voice-check on")
        return 0

    if cmd == "voice-check":
        from core.connect import set_config
        from core.voice.speaker import Speaker
        sp = Speaker(cfg)
        arg = rest[0] if rest else "status"
        if arg in ("on", "off"):
            if arg == "on" and not sp.enrolled():
                print("Nobody's enrolled yet. Run:  crea enrol")
                return 1
            set_config(cfg, "voice.wake.speaker_verification.enabled", arg == "on")
            print(f"Voice check {arg}." + (" Restart listening for it to take effect."
                                           if arg == "on" else ""))
            return 0
        st = sp.status()
        print(json.dumps(st, indent=2))
        return 0

    if cmd == "listen":
        from core.voice.loop import run as listen
        listen(cfg, vault)
        return 0

    if cmd == "voice":
        tts_dir = Path(cfg.get("paths.root")) / "tts"
        server, py = tts_dir / "server.py", tts_dir / ".venv/bin/python"
        action = rest or ["status"]
        if action == ["start"]:
            if not server.exists():
                print(f"voice service missing at {server} — re-run the installer")
                return 1
            if not py.exists():
                print(f"voice environment missing at {py} — re-run the installer")
                return 1
            import urllib.request
            try:
                urllib.request.urlopen(
                    cfg.get("voice.tts.endpoint").rsplit("/", 1)[0] + "/health", timeout=3)
                print("voice daemon already running")
                return 0
            except Exception:
                pass
            subprocess.Popen([str(py), str(server)],
                             stdout=open(cfg.path("paths.logs") / "voice.log", "a"),
                             stderr=subprocess.STDOUT)
            print("voice daemon starting (about 20s to warm up)")
        elif action == ["stop"]:
            rc = subprocess.run(["pkill", "-f", str(server)]).returncode
            print("voice daemon stopped" if rc == 0 else "no voice daemon was running")
        else:
            print("crea voice start|stop")
        return 0

    print(f"unknown command: {cmd}\n\n{USAGE}")
    return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
