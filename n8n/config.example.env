# =============================================================================
#  CREA n8n Hands Layer — configuration
#
#  1.  cp config.example.env config.env
#  2.  fill the REQUIRED values (marked below)
#  3.  ./go-live.sh
#
#  Every {{CREA_*}} token in the workflow JSON is substituted from here — nothing
#  is hardcoded. OPTIONAL values can stay blank; the workflow that needs them just
#  won't do its job until you fill it. Lines you don't touch are fine as-is.
# =============================================================================

# ── Identity ────────────────────────────────────────────────────────────────
CREA_BUSINESS_NAME=Cfilms
CREA_OWNER_NAME=Connell
CREA_OWNER_WA=                       # REQUIRED — your WhatsApp, digits only (e.g. 61412345678). Booking alerts + briefings go here.
CREA_EDITOR_WA=                      # optional — the editor's WhatsApp (card pipeline notifies them)
CREA_TIMEZONE=Australia/Sydney

# ── WhatsApp gateway (WAHA — unofficial personal-number pairing) ─────────────
CREA_WAHA_URL=http://localhost:3001  # WAHA runs here (waha/docker-compose.yml)
CREA_WAHA_API_KEY=                   # REQUIRED — invent a long random string; use the SAME one in waha/.env
CREA_WAHA_SESSION=default

# ── Brain: an OpenAI-compatible LLM endpoint (OmniRoute, or any) ────────────
CREA_OMNIROUTE_URL=                  # REQUIRED — e.g. http://localhost:4000/v1/chat/completions  (CREA's OmniRoute; `crea status` shows the port)
CREA_OMNIROUTE_KEY=                  # REQUIRED — the endpoint's API key. Also create the n8n credential "CREA OmniRoute" (Header Auth, "Authorization: Bearer <key>").
CREA_LLM_MODEL=auto                  # 'auto' = let the router pick (free-first)
CREA_BOOKING_WORKFLOW_ID=creaaiassistant   # creaaiassistant (AI, default) | creabookingagent (fixed 5 questions)

# ── Vault API — memory + job store + knowledge + availability + state ───────
CREA_VAULT_API_URL=http://127.0.0.1:5692   # go-live.sh starts vault-api/server.js here — no account needed
CREA_KNOWLEDGE_FILE=knowledge/crea-knowledge.md   # what the assistant answers from. Put your prices in its table.
STATE_STORE_URL=http://127.0.0.1:5692/state       # conversation state — served by the vault API (leave as-is)
CREA_ALERT_WEBHOOK_URL=http://127.0.0.1:5692/alert  # where workflow failures go. Point at Slack/Discord to get pinged, or leave as-is to just log them.

# ── Acuity Scheduling ──────────────────────────────────────────────────────
CREA_ACUITY_BASE=https://acuityscheduling.com/api/v1   # leave as-is
CREA_ACUITY_USER_ID=                # optional — Business Settings → Integrations → API. Enables crea-03/04/08.
CREA_ACUITY_API_KEY=                # optional — same page. Also create the n8n credential "CREA Acuity" (Basic Auth, user = User ID, pass = API Key).
#   Then in Acuity → Integrations → Webhooks, add: <your n8n>/webhook/crea-acuity  (event: appointment.scheduled)

# ── Higgsfield (card pipeline → editor) ────────────────────────────────────
CREA_HIGGSFIELD_URL=                 # optional — Higgsfield project-intake API endpoint
CREA_HIGGSFIELD_API_KEY=             # optional — Higgsfield settings. n8n credential "CREA Higgsfield" (Header Auth, "X-Api-Key: <key>").
CREA_HIGGSFIELD_PROJECT_PREFIX=Cfilms

# ── Apify (listing leads) ─────────────────────────────────────────────────
CREA_APIFY_BASE=https://api.apify.com/v2
CREA_APIFY_TOKEN=                    # optional — console.apify.com → Settings → Integrations
CREA_APIFY_ACTOR=                    # optional — the actor id/slug for your listing scraper
CREA_LEADS_AREA=                     # optional — suburb / region filter for the scrape

# ── Google Calendar + Drive (OFF by default — opt-in) ─────────────────────
#   crea-03 Calendar node and crea-06 Drive node ship disabled. Enable them in the
#   n8n editor and pick the "CREA Google" OAuth2 credential if you want them.
CREA_GCAL_ID=primary
CREA_DRIVE_PARENT_FOLDER_ID=

# ── Card pipeline ─────────────────────────────────────────────────────────
CREA_SHOOT_GAP_MINUTES=90            # a capture gap bigger than this starts a new shoot
CREA_CARD_HUMAN_GATE=true            # ask before pushing anything to Higgsfield
