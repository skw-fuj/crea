# =============================================================================
#  CREA v3.1 — n8n Hands Layer — configuration
#
#   1.  cp config.example.env config.env
#   2.  fill the REQUIRED values below (marked  ◀ REQUIRED)
#   3.  ../go-live.sh              (from the deploy/ folder, or ./go-live.sh from here)
#
#  Everything the workflows need is a {{TOKEN}} filled from this file. Values left
#  blank just mean the workflow that needs them stays switched off until you fill it.
#  This file holds secrets — it is git-ignored. Never commit config.env.
# =============================================================================

# ---- your business ----------------------------------------------------------
CREA_BUSINESS_NAME=Cfilms
CREA_OWNER_NAME=Connell
CREA_OWNER_WA=                     # ◀ REQUIRED  your WhatsApp, digits only, incl. country code, no + or spaces. e.g. 61412345678. Booking alerts + briefings land here.
CREA_EDITOR_WA=                    #   optional   the editor's WhatsApp (card pipeline handoff). Blank = send editor pings to the owner.
CREA_TIMEZONE=Australia/Sydney

# ---- WhatsApp gateway (WAHA, runs in Docker) --------------------------------
CREA_WAHA_API_KEY=                 # ◀ REQUIRED  invent a long random string (e.g. `openssl rand -hex 24`). Protects the local WAHA API.
CREA_WAHA_URL=http://waha:3000     #   leave as-is for the Docker stack. (host-run n8n: http://localhost:3001)
CREA_WAHA_SESSION=default
CREA_SHARED_NUMBER=                #   leave blank — go-live.sh sets this. "true" when CREA runs on the SAME
                                  #   WhatsApp number as CREA_OWNER_WA (you'll get alerts in your "Message
                                  #   Yourself" chat, and CREA won't relay every incoming message back to you
                                  #   since you already see them). "false"/blank = a separate number for CREA.

# ---- Voice calls (Twilio, optional — enables phone booking) ----------------
# The same booking assistant, answering by phone. Twilio handles the call audio
# (speech-to-text on the way in, text-to-speech on the way out) and POSTs each turn
# to n8n's webhook — same brain, same brief, same hold->confirm->Acuity flow as WhatsApp.
# Leave CREA_TWILIO_ACCOUNT_SID blank and voice stays off; everything else is unaffected.
#   1. Twilio console -> Account -> get the Account SID + Auth Token
#   2. Buy a Voice-capable number -> set its "A call comes in" webhook to
#      {{CREA_PUBLIC_BASE_URL}}/webhook/crea-voice-inbound  (POST)  -- set after step 3
#   3. Unlike WhatsApp (WAHA polls out), Twilio must reach n8n from the internet.
#      go-live.sh starts a Cloudflare Tunnel container for this -- see VOICE.md.
CREA_TWILIO_ACCOUNT_SID=           #   optional — blank = voice booking stays off
CREA_TWILIO_AUTH_TOKEN=            #   optional — used to verify inbound requests are really from Twilio
CREA_TWILIO_NUMBER=                #   optional — the Twilio number customers call, digits only e.g. 61280001234
CREA_PUBLIC_BASE_URL=              #   optional — the public https URL Twilio can reach n8n on (Cloudflare Tunnel
                                  #   hostname once you've set one up in the Cloudflare dashboard, e.g.
                                  #   https://crea-voice.yourdomain.com). See VOICE.md.
CREA_VOICE_LANG=en-AU              #   speech recognition + accent hint, e.g. en-AU, en-US, en-GB
CREA_VOICE_NAME=Polly.Olivia-Neural #  Twilio <Say> voice. Aussie-accented options: Polly.Olivia-Neural (f),
                                  #   Polly.Russell-Neural (m). Full list: Twilio docs -> Voice -> Text to Speech.
CREA_CF_TUNNEL_TOKEN=              #   optional — the token from your Cloudflare Tunnel (Zero Trust -> Tunnels ->
                                  #   create -> Docker). Blank = the cloudflared container stays idle.

# ---- the assistant's brain (any OpenAI-compatible chat API) -----------------
# Recommended: Groq — free tier, fast, no card required. Sign up at https://console.groq.com
# then create an API key. Or use OpenAI: URL https://api.openai.com/v1/chat/completions , model gpt-4o-mini.
CREA_OMNIROUTE_URL=https://api.groq.com/openai/v1/chat/completions   # ◀ REQUIRED
CREA_OMNIROUTE_KEY=                # ◀ REQUIRED  the API key from the provider above
CREA_LLM_MODEL=openai/gpt-oss-120b #   Groq: openai/gpt-oss-120b (good) or openai/gpt-oss-20b (faster). OpenAI: gpt-4o-mini.

# Optional second endpoint — CREA tries this if the primary fails, before falling back to the
# fixed 5-question flow. Recommended for resilience: e.g. primary = Groq, fallback = OpenAI.
CREA_OMNIROUTE_URL_2=              #   optional  a second OpenAI-compatible chat endpoint
CREA_OMNIROUTE_KEY_2=              #   optional  its API key
CREA_LLM_MODEL_2=                  #   optional  its model name (blank = reuse CREA_LLM_MODEL)

# ---- booking behaviour (Connell's two decisions — see BOOKING.md) --------------
# How the assistant handles PRICE:
#   defer       never quotes a number — "I'll get you an exact quote" (safest, default)
#   packages    a rough range from the prices in your knowledge file + a size band
#   calculator  a real figure computed from knowledge/pricing.json (copy pricing.example.json)
CREA_PRICING_MODE=defer

# What the assistant reads back before it holds a booking:
#   with_price    "...listing video, 40 Awaba St, Sat 10am, ~$650 — all correct?"  (needs a pricing mode)
#   booking_only  "...listing video, 40 Awaba St, Sat 10am — all correct?"  (Connell prices it after)
CREA_CONFIRM_MODE=booking_only

# When a customer confirms, what happens:
#   hold   CREA holds it and WhatsApps you the brief + a one-tap CONFIRM (recommended)
#   off    CREA just hands you a "quote-ready enquiry" — you book it yourself (this is v3 behaviour)
CREA_AUTO_BOOK=hold

# ---- CREA's memory (the vault API, runs in Docker) -------------------------
CREA_VAULT_API_URL=http://vault-api:5692          # leave as-is for the Docker stack
STATE_STORE_URL=http://vault-api:5692/state       # leave as-is
# CREA_ALERT_WEBHOOK_URL: where incident alerts go. Default records them in the vault (alerts/
# folder) and the self-check pages you over WhatsApp. To ALSO get a push notification, point
# this at an ntfy.sh topic URL, a Slack incoming webhook, or any URL that accepts a JSON POST
# of {workflow, node, severity, message}. Blank/default = vault only.
CREA_ALERT_WEBHOOK_URL=http://vault-api:5692/alert
LLM_CIRCUIT_FAILS=4                #   consecutive model failures before CREA skips the model for a cooldown
LLM_CIRCUIT_COOLDOWN_S=300         #   how long the model is skipped after the circuit opens (seconds)
CREA_KNOWLEDGE_FILE=knowledge/crea-knowledge.md
CREA_VAULT_DIR=                    #   optional but recommended: an absolute path to a folder inside your
                                  #   CREA Obsidian vault, e.g. /Users/connell/Obsidian/CREA/automations
                                  #   Job/lead/inbox notes land there as Markdown and Obsidian Sync backs them
                                  #   up + puts them on your phone. Blank = kept in a Docker volume (local only).
                                  #   See DATA-AND-BACKUP.md.
CREA_VAULT_PROFILE=crea            #   crea  = ALSO write Job/Client/Lead notes in CREA's own frontmatter into
                                  #           Jobs/ Clients/ Leads/ so the CREA voice assistant reads the same
                                  #           memory (recommended — point CREA_VAULT_DIR at your CREA vault).
                                  #   plain = only the automations' own notes. Nothing else changes either way.

# ---- Acuity Scheduling (optional — enables the shoot-ops automations) -------
# Acuity → Integrations → API. Copy the User ID and API Key. No webhook to set up:
# crea-03 polls the Acuity API every 10 minutes.
CREA_ACUITY_USER_ID=              #   optional
CREA_ACUITY_API_KEY=             #   optional
CREA_ACUITY_APPT_TYPE_ID=        #   optional — the appointment type CREA books into (and narrows availability). Acuity → the type's page → the number in the URL.
CREA_ACUITY_BASE=https://acuityscheduling.com/api/v1

# ---- card pipeline / Higgsfield (optional) ---------------------------------
CREA_HIGGSFIELD_URL=              #   optional — leave blank and the "push to Higgsfield" step stays disabled
CREA_HIGGSFIELD_API_KEY=
CREA_HIGGSFIELD_PROJECT_PREFIX=Cfilms
CREA_SHOOT_GAP_MINUTES=90         #   a gap this long between clips starts a new shoot
CREA_CARD_HUMAN_GATE=true         #   card pipeline always waits for your OK before pushing downstream

# ---- listing leads / Apify (optional) ------------------------------------
CREA_APIFY_TOKEN=                 #   optional
CREA_APIFY_BASE=https://api.apify.com/v2
CREA_APIFY_ACTOR=               #   the actor that scrapes new listings, e.g. someuser~realestate-au-scraper
CREA_LEADS_AREA=Mosman

# ---- Google Calendar / Drive (optional, off by default) ------------------
CREA_GCAL_ID=primary
CREA_DRIVE_PARENT_FOLDER_ID=

# ---- routing -------------------------------------------------------------
CREA_BOOKING_WORKFLOW_ID=creaaiassistant   # creaaiassistant (AI, default) or creabookingagent (fixed 5-question)
CREA_N8N_BASE_URL=http://localhost:5678

# ---- abuse / rate limiting ------------------------------------------------
CREA_RATE_LIMIT_PER_MIN=12         #   more than this many messages from one sender in 60s = flood: CREA
                                  #   stops replying to them for ~1 min and logs it. Raise if you're busy.
CREA_BLOCKLIST=                    #   comma-separated WhatsApp numbers (digits) CREA ignores entirely

# ---- n8n editor login (optional — set both to password-protect http://localhost:5678) ----
# Only needed if this Mac is shared or reachable on your network. Leave blank on a personal Mac.
CREA_N8N_USER=
CREA_N8N_PASSWORD=

# ---- ports (optional — change only if 5678 / 3001 are already in use on this Mac) ----
CREA_N8N_PORT=5678
CREA_WAHA_PORT=3001
CREA_VAULT_PORT=5692           #   health dashboard at http://localhost:5692/status.html

# ---- host watchdog (optional but recommended) ----------------------------
# ./go-live.sh installs a background check (launchd) that every N minutes: restarts any
# container that's down, restarts a wedged n8n, tries to re-connect a dropped WhatsApp
# session, prunes disk if it's low, and pages you if it can't fix something.
CREA_WATCHDOG_MINUTES=5

