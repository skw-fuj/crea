# =============================================================================
#  CREA n8n Hands Layer — configuration
#  Copy to  config.env  and fill every value, then run  ./fill-config.sh
#  Nothing in the workflow JSON is hardcoded — every {{CREA_*}} token below
#  is substituted into workflows/_filled/ for import.
# =============================================================================

# --- Identity / brand -------------------------------------------------------
CREA_BUSINESS_NAME=Cfilms
CREA_OWNER_NAME=
CREA_OWNER_WA=                       # owner's number, digits only, e.g. 61412345678  (yours first, friend's later)
CREA_EDITOR_WA=                      # editor's WhatsApp, digits only
CREA_TIMEZONE=Australia/Sydney

# --- WhatsApp via WAHA (unofficial, personal number — per CREA manual) ------
CREA_WAHA_URL=http://localhost:3001  # WAHA base URL (Docker container)
CREA_WAHA_API_KEY=                   # X-Api-Key you set on the WAHA container
CREA_WAHA_SESSION=default            # WAHA session name

# --- n8n wiring -----------------------------------------------------------
CREA_N8N_BASE_URL=http://localhost:5678
GLOBAL_ERROR_HANDLER_ID=trisglobalerrhdlr   # existing TRIS OS global error handler
CREA_WA_SEND_ID=                     # filled after importing crea-wa-send (its workflow id)
STATE_STORE_URL=http://127.0.0.1:5691/state # existing TRIS OS conversation state store
ALERT_WEBHOOK_URL=                   # where layer-3 failure alerts POST (Slack/Discord/WA)

# --- Brain: OmniRoute (local, OpenAI-compatible) ---------------------------
CREA_OMNIROUTE_URL=http://localhost:4000/v1/chat/completions
CREA_OMNIROUTE_KEY=
CREA_LLM_MODEL=auto                  # OmniRoute routes; 'auto' = free-first

# --- Vault API (Hermes / tiny vault-writer — the "memory" seam) -----------
CREA_VAULT_API_URL=http://127.0.0.1:5692   # go-live.sh starts this (vault-api/server.js)
#   POST {CREA_VAULT_API_URL}/job      {jobId, client, address, type, date, ...}
#   GET  {CREA_VAULT_API_URL}/knowledge?q=...     -> text chunks for LLM grounding
#   GET  {CREA_VAULT_API_URL}/jobs?filter=unpaid|tomorrow|active

# --- Acuity Scheduling ----------------------------------------------------
CREA_ACUITY_BASE=https://acuityscheduling.com/api/v1   # real Acuity, for crea-03/04/08 /appointments (needs the CREA Acuity credential). The AI assistant reads availability from the vault API instead.
CREA_ACUITY_USER_ID=
CREA_ACUITY_API_KEY=
#   Acuity webhook -> {CREA_N8N_BASE_URL}/webhook/crea-acuity   (event: appointment.scheduled)

# --- Google (Calendar + Drive + Sheets tracker) --------------------------
#   Create an n8n credential "CREA Google" (OAuth2) and select it in each Google node.
CREA_GCAL_ID=primary
CREA_DRIVE_PARENT_FOLDER_ID=         # Drive folder where per-shoot folders are created
CREA_TRACKER_SHEET_ID=              # Google Sheet used as the job tracker
CREA_TRACKER_TAB=Jobs

# --- Higgsfield (editor handoff) ----------------------------------------
CREA_HIGGSFIELD_URL=                 # real Higgsfield API endpoint for project/asset intake (see SETUP §9)
CREA_HIGGSFIELD_API_KEY=
CREA_HIGGSFIELD_PROJECT_PREFIX=Cfilms

# --- Apify (lead scraping) --------------------------------------------
CREA_APIFY_BASE=https://api.apify.com/v2
CREA_APIFY_TOKEN=
CREA_APIFY_ACTOR=                    # actor id/slug for the listing scraper
CREA_LEADS_AREA=                     # suburb / region filter

# --- Card pipeline ----------------------------------------------------
CREA_SHOOT_GAP_MINUTES=90            # new shoot if capture gap > this
CREA_CARD_HUMAN_GATE=true            # require owner OK before Higgsfield push

# --- Booking handler: creaaiassistant (AI, default) or creabookingagent (deterministic 5-question) ---
CREA_BOOKING_WORKFLOW_ID=creaaiassistant

# --- AI assistant knowledge (served via vault API /knowledge) ---
CREA_KNOWLEDGE_FILE=knowledge/crea-knowledge.md
