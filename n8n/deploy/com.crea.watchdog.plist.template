<?xml version="1.0" encoding="UTF-8"?>
<!-- go-live.sh fills __WATCHDOG_SH__ and __INTERVAL__ and installs this as
     ~/Library/LaunchAgents/com.crea.watchdog.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.crea.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__WATCHDOG_SH__</string>
  </array>
  <key>StartInterval</key><integer>__INTERVAL__</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
