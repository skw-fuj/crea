# Generic facet — fill and run ../fill-config.sh pointed at this folder.
FACET_NAME=
FACET_INBOUND_PATH=facet-inbound
FACET_CHANNEL=waha                 # waha | meta | telegram | webhook

# channel creds (only the row for FACET_CHANNEL matters)
FACET_WAHA_URL=http://localhost:3001
FACET_WAHA_API_KEY=
FACET_WAHA_SESSION=default
FACET_META_PHONE_ID=
FACET_META_TOKEN=
FACET_TELEGRAM_TOKEN=
FACET_WEBHOOK_SINK_URL=

# brain + knowledge
FACET_OMNIROUTE_URL=http://localhost:4000/v1/chat/completions
FACET_LLM_MODEL=auto
FACET_SYSTEM_PROMPT=You are a concise assistant. Answer only from the context. If unsure, say a human will follow up.
FACET_KNOWLEDGE_URL=http://127.0.0.1:5692/vault/knowledge
FACET_ESCALATION_TO=              # where 'needs a human' notifications go (a number / chat id)

# shared wiring (from the CREA pack)
# error workflow = creaerrorhandler (baked into the templates)
STATE_STORE_URL=http://127.0.0.1:5692/state

# scheduled digest
FACET_DIGEST_CRON=30 6 * * *
FACET_DIGEST_SOURCE_URL=
FACET_DIGEST_PROMPT=Summarise the context in 4-6 plain-text lines. Lead with what needs action.
FACET_DIGEST_RECIPIENT=
