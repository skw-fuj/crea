        "url": "{{CREA_VAULT_API_URL}}/inbox",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channel: 'whatsapp', from: $json.from, text: $json.text, type: $json.type, flood: !!$json.flooding, receivedAt: $json.receivedAt }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "inbox",
      "name": "Vault Inbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1220,
        400
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2
    },
    {
