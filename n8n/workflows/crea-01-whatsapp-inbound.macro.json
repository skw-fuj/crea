{
  "name": "CREA \u2014 WhatsApp Inbound Capture (Macro)",
  "meta": {
    "family": "reliable_ingress",
    "mode": "macro",
    "note": "Front door for the owner's WhatsApp (via WAHA). Ignores own outgoing messages, dedupes, then: an active booking conversation -> hand to the assistant; anything else -> vault inbox (+ relay to the owner if CREA runs on a separate number). Once a lead is handed to the owner it goes quiet on that chat for 3 days so the owner deals with the customer directly. No model memory; routing is deterministic.",
    "steps": [
      "parse_inbound_message",
      "dedupe",
      "load_stage",
      "classify_intent",
      "route",
      "persist_inbox"
    ]
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crea-wa-inbound",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wh",
      "name": "WAHA Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "crea-wa-inbound"
    },
    {
      "parameters": {
        "jsCode": "const b = items[0].json.body || items[0].json;\nif (b.event && b.event !== 'message') return [];\nconst p = b.payload || b;\nif (p.fromMe === true) return [];              // our own / the owner's outgoing message\nconst raw = String(p.from || '');\nif (/@g\\.us|@broadcast|status@/i.test(raw)) return [];   // groups + status updates: not booking DMs\nconst from = raw.replace(/@.*/, '').replace(/[^0-9]/g, '');\nif (!from) return [];                          // unparseable sender: drop, don't error\nconst blocked = ('{{CREA_BLOCKLIST}}'.match(/\\d{5,}/g) || []);\nif (blocked.includes(from)) return [];         // blocklist\nconst type = p.type || 'chat';\nlet text = String(p.body || p.caption || p.text || '').replace(/\\u0000/g, '').trim().slice(0, 2000);\nif (!text) text = type === 'chat' ? '' : ('[' + type + ' message \\u2014 not readable by the assistant]');\nif (!text) return [];                          // empty text message: nothing to do\n// account this was sent TO = the number CREA runs on (tells whether CREA is on the owner's own number)\nconst toAcct = String(p.to || p.me || (b.me && b.me.id) || '').replace(/@.*/, '').replace(/[^0-9]/g, '');\nreturn [{ json: { msgId: p.id || p.messageId || (p.key && p.key.id) || null, from, text, type, toAcct, receivedAt: new Date().toISOString() } }];"
      },
      "id": "parse",
      "name": "Parse & Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ '{{STATE_STORE_URL}}?key=' + $json.from }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "load",
      "name": "Load Stage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const inc = $node['Parse & Guard'].json;\nconst stored = items[0].json || {};\nconst now = Date.now();\n// dedupe: same message id, or the exact same text within 10s (engines without stable ids)\nif (inc.msgId && stored.lastMsgId === inc.msgId) return [];\nif (inc.text && stored.lastText === inc.text && stored.lastInboundAt && (now - Date.parse(stored.lastInboundAt) < 10000)) return [];\n\n// rate limit: keep the last 60s of inbound times for this sender\nconst RATE = Math.max(3, parseInt('{{CREA_RATE_LIMIT_PER_MIN}}', 10) || 12);\nconst msgTimes = (Array.isArray(stored.msgTimes) ? stored.msgTimes : []).filter(x => now - x < 60000).concat(now).slice(-40);\nconst flooding = msgTimes.length > RATE;\n\n// once a lead is handed to the owner, the bot stays quiet on that chat for 3 days\nconst daysSinceHuman = stored.humanSince ? (now - Date.parse(stored.humanSince)) / 864e5 : 999;\nconst humanHandled = stored.mode === 'human' && daysSinceHuman < 3;\n\nconst activeBooking = !humanHandled && !flooding && ((!!stored.stage && stored.stage !== 'close') || stored.mode === 'ai' || (Array.isArray(stored.transcript) && stored.transcript.length > 0 && !stored.booking_ready));\nconst t = (inc.text || '').toLowerCase();\nconst bookingWords = ['shoot','photo','photos','video','listing','book','booking','quote','drone','tour','floor plan','floorplan','twilight'];\nconst looksBooking = !humanHandled && !flooding && bookingWords.some(w => t.includes(w));\nlet target = (activeBooking || looksBooking) ? 'booking' : 'other';\n// if the assistant is mid-reply on this chat, don't start a second turn \u2014 queue the text\nconst busy = stored.assistantBusyUntil && now < Date.parse(stored.assistantBusyUntil);\nif (target === 'booking' && busy) target = 'queue';\n\n// on a shared number the owner already sees every incoming message. Config flag wins; else\n// infer from the account the message was sent to vs CREA_OWNER_WA.\nconst flag = String('{{CREA_SHARED_NUMBER}}').toLowerCase();\nconst ownerDigits = String('{{CREA_OWNER_WA}}').replace(/[^0-9]/g, '');\nconst toAcct = String(inc.toAcct || '');\nconst inferShared = !!(toAcct && ownerDigits && (toAcct === ownerDigits || toAcct.endsWith(ownerDigits) || ownerDigits.endsWith(toAcct)));\nconst sharedNumber = flag === 'true' ? true : (flag === 'false' ? false : inferShared);\n\nconst queuedText = String(stored.queuedText || '');\n// owner one-tap booking control (separate-number setups only; on a shared number the\n// owner's own messages are fromMe and never reach here \u2014 they use ./go-live.sh --confirm or voice)\nconst cm = String(inc.text || '').trim().match(/^(confirm|decline)\\s+([a-z0-9]{3,7})$/i);\nconst isOwner = !!(ownerDigits && inc.from === ownerDigits);\nconst bookAction = (cm && isOwner) ? cm[1].toLowerCase() : '';\nconst bookRef = (cm && isOwner) ? cm[2].toUpperCase() : '';\nconst finalTarget = bookAction ? 'ownerbook' : target;\nreturn [{ json: { ...inc, target: finalTarget, bookAction, bookRef, flooding, msgTimes, humanHandled, queuedText, relayToOwner: !sharedNumber && !flooding && !bookAction, priorStage: stored.stage || null } }];"
      },
      "id": "classify",
      "name": "Classify & Dedupe",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.target }}",
                    "rightValue": "booking",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "booking"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.target }}",
                    "rightValue": "queue",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "queue"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.target }}",
                    "rightValue": "ownerbook",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              },
              "outputKey": "ownerbook"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "route",
      "name": "Route by Target",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1000,
        300
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "{{CREA_BOOKING_WORKFLOW_ID}}",
          "mode": "id",
          "cachedResultName": "CREA booking handler"
        },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "from": "={{ $node['Classify & Dedupe'].json.from }}",
            "text": "={{ $node['Classify & Dedupe'].json.text }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "from",
              "displayName": "from",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "text",
              "displayName": "text",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
