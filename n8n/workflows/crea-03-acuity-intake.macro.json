{
  "id": "creaacuityintake",
  "name": "CREA — Acuity Intake (Macro)",
  "meta": {
    "family": "reliable_ingress",
    "mode": "macro",
    "note": "Polls the Acuity API every 10 min for new bookings (no webhook, no public URL needed) -> job record in the vault (Google Calendar event optional) + a WhatsApp heads-up to the owner. Idempotent: a watermark of processed Acuity appointment ids is kept in the vault state.",
    "steps": [
      "poll_schedule",
      "load_watermark",
      "fetch_upcoming_appointments",
      "select_new",
      "persist_vault",
      "calendar_event",
      "notify_owner",
      "save_watermark"
    ]
  },
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "minutes", "minutesInterval": 10 } ] }
      },
      "id": "poll",
      "name": "Every 10 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [ 180, 240 ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crea-acuity-poll",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "runnow",
      "name": "Run Now (local)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [ 180, 380 ],
      "webhookId": "crea-acuity-poll"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ '{{STATE_STORE_URL}}?key=acuity-intake' }}",
        "options": { "timeout": 10000 }
      },
      "id": "wm",
      "name": "Load Watermark",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 380, 300 ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// build the Acuity query window: today .. +120d\nconst pad = n => String(n).padStart(2,'0');\nconst d = new Date();\nconst minDate = `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`;\nconst e = new Date(Date.now() + 120*864e5);\nconst maxDate = `${e.getFullYear()}-${pad(e.getMonth()+1)}-${pad(e.getDate())}`;\nconst wm = items[0].json || {};\nconst processed = Array.isArray(wm.processed) ? wm.processed.map(String) : [];\nreturn [{ json: { minDate, maxDate, processed } }];"
      },
      "id": "win",
      "name": "Query Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 560, 300 ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ '{{CREA_ACUITY_BASE}}/appointments?max=100&direction=ASC&minDate=' + $json.minDate + '&maxDate=' + $json.maxDate }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Accept", "value": "application/json" } ] },
        "options": { "timeout": 20000 }
      },
      "id": "fetch",
      "name": "Fetch Upcoming",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 760, 300 ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// keep only appointments we've never processed; build job objects\nconst win = $('Query Window').first().json;\nconst processed = new Set((win.processed || []).map(String));\nconst appts = $('Fetch Upcoming').all().map(i => i.json).flatMap(x => Array.isArray(x) ? x : [x]).filter(a => a && a.id);\nconst fresh = appts.filter(a => !processed.has(String(a.id)));\nconst allIds = [...processed, ...fresh.map(a => String(a.id))].slice(-800);\nif (!fresh.length) return [];\nreturn fresh.map(a => {\n  const forms = (a.forms || []).flatMap(f => (f.values || []));\n  const pick = needle => { const m = forms.find(v => (v.name||'').toLowerCase().includes(needle)); return m ? m.value : ''; };\n  return { json: {\n    jobId: 'ACU-' + a.id,\n    apptId: String(a.id),\n    client: [a.firstName, a.lastName].filter(Boolean).join(' '),\n    phone: (a.phone || '').replace(/[^0-9]/g,''),\n    email: a.email || '',\n    type: a.type || String(a.appointmentTypeID || ''),\n    address: pick('address') || pick('property') || a.location || '',\n    datetime: a.datetime || '',\n    endTime: a.endTime || '',\n    duration: a.duration || '',\n    price: a.price || '',\n    notes: a.notes || pick('note') || '',\n    calendar: a.calendar || '',\n    createdAt: new Date().toISOString(),\n    _allProcessedIds: allIds\n  } };\n});"
      },
      "id": "sel",
      "name": "Select New",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [ 960, 300 ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{CREA_VAULT_API_URL}}/job",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify((({_allProcessedIds, ...rest}) => rest)($json)) }}",
        "options": { "timeout": 10000 }
      },
      "id": "vault",
      "name": "Vault Job Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 1160, 300 ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": { "__rl": true, "value": "{{CREA_GCAL_ID}}", "mode": "id" },
        "start": "={{ $node['Select New'].json.datetime }}",
        "end": "={{ $node['Select New'].json.endTime || $node['Select New'].json.datetime }}",
        "additionalFields": {
          "summary": "={{ 'Shoot: ' + $node['Select New'].json.client + ' — ' + ($node['Select New'].json.address || $node['Select New'].json.type) }}",
          "description": "={{ 'Job ' + $node['Select New'].json.jobId + '\\nType: ' + $node['Select New'].json.type + '\\nPhone: ' + $node['Select New'].json.phone + '\\nNotes: ' + $node['Select New'].json.notes }}",
          "location": "={{ $node['Select New'].json.address }}"
        }
      },
      "id": "cal",
      "name": "Calendar Event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [ 1360, 200 ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "disabled": true
    },
    {
      "parameters": {
        "workflowId": { "__rl": true, "value": "creawasend", "mode": "id", "cachedResultName": "CREA — WA Send (WAHA atomic)" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "to": "{{CREA_OWNER_WA}}",
            "text": "={{ 'New booking (Acuity): ' + $node['Select New'].json.client + ' — ' + $node['Select New'].json.type + ' @ ' + $node['Select New'].json.datetime + '\\n' + ($node['Select New'].json.address || '') }}"
          },
          "matchingColumns": [],
          "schema": [],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "options": {}
      },
      "id": "notify",
      "name": "Notify Owner",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [ 1360, 360 ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{STATE_STORE_URL}}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ key: 'acuity-intake', processed: $node['Select New'].json._allProcessedIds, lastPoll: new Date().toISOString() }) }}",
        "options": { "timeout": 10000 }
      },
      "id": "save",
      "name": "Save Watermark",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [ 1560, 360 ],
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 10 min": { "main": [ [ { "node": "Load Watermark", "type": "main", "index": 0 } ] ] },
    "Run Now (local)": { "main": [ [ { "node": "Load Watermark", "type": "main", "index": 0 } ] ] },
    "Load Watermark": { "main": [ [ { "node": "Query Window", "type": "main", "index": 0 } ] ] },
    "Query Window": { "main": [ [ { "node": "Fetch Upcoming", "type": "main", "index": 0 } ] ] },
    "Fetch Upcoming": { "main": [ [ { "node": "Select New", "type": "main", "index": 0 } ] ] },
    "Select New": { "main": [ [ { "node": "Vault Job Record", "type": "main", "index": 0 } ] ] },
    "Vault Job Record": { "main": [ [ { "node": "Calendar Event", "type": "main", "index": 0 } ] ] },
    "Calendar Event": { "main": [ [ { "node": "Notify Owner", "type": "main", "index": 0 } ] ] },
    "Notify Owner": { "main": [ [ { "node": "Save Watermark", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1", "errorWorkflow": "creaerrorhandler" }
}
