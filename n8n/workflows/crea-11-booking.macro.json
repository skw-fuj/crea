{
  "id": "creabooking",
  "name": "CREA \u2014 Booking (hold + confirm)",
  "meta": {
    "family": "conversation_state_machine",
    "mode": "macro",
    "note": "The booking hold/confirm bridge. action=hold (from the AI assistant when a customer confirms the readback): writes a held booking to the vault and WhatsApps the owner a one-tap CONFIRM <ref> / DECLINE <ref>. action=confirm (owner replies CONFIRM <ref> \u2014 via crea-01, ./go-live.sh --confirm, or the CREA voice assistant): creates the real Acuity appointment (admin mode, only if Acuity is configured and the time is ISO 8601), writes the CREA-native job note, tells the customer they're confirmed. action=decline: releases the hold. Nothing here charges money; the real appointment is only created after the owner's explicit CONFIRM.",
    "steps": [
      "normalize",
      "route",
      "hold_or_confirm_or_decline",
      "acuity_create",
      "job_note",
      "notify"
    ]
  },
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "action",
              "type": "string"
            },
            {
              "name": "from",
              "type": "string"
            },
