        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ appointmentTypeID: Number($json.appointmentTypeID) || $json.appointmentTypeID, datetime: $json.datetime, firstName: $json.firstName, lastName: $json.lastName, email: $json.email || undefined, phone: $json.phone || undefined, notes: $json.notes || undefined }) }}",
