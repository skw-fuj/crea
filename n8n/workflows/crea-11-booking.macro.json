      "id": "acucreate",
      "name": "Create Acuity Appointment",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1480,
        240
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const p = $node['Prep Acuity'].json;\nlet acuityOk = false;\ntry { const r = $node['Create Acuity Appointment'].json; acuityOk = !!(r && (r.id || r.datetime)); } catch (e) {}\nconst customerMsg = 'You\u2019re confirmed' + (p.datetime && p.datetimeOk ? ' for ' + p.datetime : '') +\n  (p.address ? ' \u2014 ' + p.address : '') + '. See you then! \u2014 {{CREA_OWNER_NAME}}';\nconst ownerMsg = 'Booked \u2713 ref ' + p.ref +\n  (p.acuityConfigured ? (acuityOk ? ' \u2014 added to Acuity' : ' \u2014 Acuity create FAILED, add it manually') : ' \u2014 add to Acuity manually');\nreturn [{ json: { ref: p.ref, from: p.from, acuityOk, customerMsg, ownerMsg,\n  job: { jobId: 'WA-' + p.ref, client: (p.firstName + ' ' + p.lastName).trim(), address: p.address,\n    datetime: p.datetime, type: p.service, price: p.price, phone: p.phone, email: p.email,\n    source: 'whatsapp', notes: p.notes, status: 'Booked' } } }];"
      },
